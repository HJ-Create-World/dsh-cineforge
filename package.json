{
  "name": "dsh-cineforge",
  "version": "0.2.0",
  "description": "CineForge 影铸 · AI 视频导演台 —— DSH 视频创作增强版插件。把一句 idea 扩写成文案、分镜与动效映射，编译成 HyperFrames 成片；让普通模型的视频创作也有 Opus 级设计感。上游 video-shotcraft (Apache-2.0)。",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "skills",
    "knowledge",
    "scripts",
    "docs",
    "examples",
    "upstream/catalog.json",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "NOTICE",
    "spec.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.2-rc.3"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "video",
    "hyperframes",
    "video-shotcraft",
    "storyboard",
    "motion-design",
    "cordis"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/HJ-Create-World/dsh-cineforge.git"
  },
  "homepage": "https://github.com/HJ-Create-World/dsh-cineforge#readme",
  "bugs": {
    "url": "https://github.com/HJ-Create-World/dsh-cineforge/issues"
  },
  "author": "HJ-Create-World",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {},
  "scripts": {
    "test": "node scripts/self-test.mjs",
    "compile": "node scripts/compile-hf.mjs",
    "verify": "node scripts/verify-hf.mjs",
    "cards": "node scripts/build-card-index.mjs --out knowledge",
    "install:local": "node scripts/install-local.mjs install --apply",
    "install:status": "node scripts/install-local.mjs status",
    "install:verify": "node scripts/install-local.mjs verify",
    "install:undo": "node scripts/install-local.mjs uninstall --apply"
  }
}
